{
  "discipline": "electrical",
  "version": 1,
  "questions": [
    {
      "id": "panel_type",
      "order": 1,
      "label": "What type of panel do you need?",
      "help": "This decides the default device chain and layout style.",
      "type": "select",
      "options": [
        {
          "value": "irrigation",
          "label": "Irrigation pump station"
        },
        {
          "value": "fertigation",
          "label": "Fertigation plant control"
        },
        {
          "value": "distribution",
          "label": "General distribution board"
        },
        {
          "value": "mcc",
          "label": "Motor control center (MCC)"
        }
      ],
      "required": true
    },
    {
      "id": "supply_voltage",
      "order": 2,
      "label": "What is the main supply voltage?",
      "help": "Line-to-line nominal voltage.",
      "type": "select",
      "options": [
        {
          "value": "3x400",
          "label": "3 x 400 V (3-phase)"
        },
        {
          "value": "1x230",
          "label": "1 x 230 V (single-phase)"
        }
      ],
      "required": true
    },
    {
      "id": "short_circuit_ka",
      "order": 3,
      "label": "Required short-circuit rating at the panel (kA)?",
      "help": "Use the highest fault level you expect at the point of connection.",
      "type": "select",
      "options": [
        {
          "value": 6,
          "label": "6 kA"
        },
        {
          "value": 10,
          "label": "10 kA"
        },
        {
          "value": 25,
          "label": "25 kA"
        },
        {
          "value": 36,
          "label": "36 kA"
        }
      ],
      "required": true
    },
    {
      "id": "main_in_current_a",
      "order": 4,
      "label": "What is the main incoming current rating (A)?",
      "help": "Approximate maximum continuous current of the panel.",
      "type": "number",
      "min": 32,
      "max": 630,
      "step": 1,
      "required": true
    },
    {
      "id": "main_isolator",
      "order": 5,
      "label": "Do you need a main isolator switch (separate from the breaker)?",
      "help": "If yes, the system adds a 4-pole isolator upstream of the main breaker.",
      "type": "boolean",
      "required": true,
      "default": true
    },
    {
      "id": "has_spd",
      "order": 6,
      "label": "Do you require a surge protection device (SPD)?",
      "help": "Recommended for outdoor panels and sensitive electronics.",
      "type": "boolean",
      "required": true,
      "default": true
    },
    {
      "id": "has_energy_meter",
      "order": 7,
      "label": "Do you require an energy meter in the panel?",
      "help": "3-phase meter (kWh) with CTs if needed.",
      "type": "boolean",
      "required": true,
      "default": true
    },
    {
      "id": "feeders_count",
      "order": 8,
      "label": "How many outgoing feeders?",
      "help": "Total number of circuits leaving the panel (pumps, sockets, lighting, machines).",
      "type": "number",
      "min": 1,
      "max": 48,
      "step": 1,
      "required": true,
      "default": 6
    },
    {
      "id": "feeders_preset",
      "order": 9,
      "label": "Quick preset for typical feeders",
      "help": "Choose a preset to auto-fill typical feeders. You can edit them later.",
      "type": "select",
      "options": [
        {
          "value": "all_pumps",
          "label": "All pumps"
        },
        {
          "value": "mixed_pumps_io",
          "label": "Pumps + industrial outlets"
        },
        {
          "value": "light_sockets",
          "label": "Lighting + sockets"
        },
        {
          "value": "custom",
          "label": "No preset (I will define each feeder)"
        }
      ],
      "required": true,
      "default": "mixed_pumps_io"
    },
    {
      "id": "brand",
      "order": 10,
      "label": "Preferred manufacturer family?",
      "help": "Controls the priority of parts in the catalog (e.g. CHINT vs ABB).",
      "type": "select",
      "options": [
        {
          "value": "CHINT",
          "label": "CHINT"
        },
        {
          "value": "ABB",
          "label": "ABB"
        },
        {
          "value": "Schneider",
          "label": "Schneider"
        },
        {
          "value": "NoPref",
          "label": "No preference"
        }
      ],
      "required": true,
      "default": "CHINT"
    },
    {
      "id": "breaker_series",
      "order": 11,
      "label": "Preferred breaker series for outgoing feeders?",
      "help": "NXB is MCB; NM1 is MCCB; you can let the system decide.",
      "type": "select",
      "options": [
        {
          "value": "NXB",
          "label": "NXB (MCB)"
        },
        {
          "value": "NM1",
          "label": "NM1 (MCCB)"
        },
        {
          "value": "Any",
          "label": "Let the system choose"
        }
      ],
      "required": true,
      "default": "NXB"
    },
    {
      "id": "enclosure_ip",
      "order": 12,
      "label": "Required enclosure IP rating?",
      "help": "Higher IP is needed outdoors or in wet/corrosive environments.",
      "type": "select",
      "options": [
        {
          "value": "IP54",
          "label": "IP54 (indoor, basic protection)"
        },
        {
          "value": "IP65",
          "label": "IP65 (dust/splash-proof)"
        },
        {
          "value": "IP66",
          "label": "IP66 (outdoor, jet-proof)"
        }
      ],
      "required": true,
      "default": "IP65"
    },
    {
      "id": "has_plc",
      "order": 13,
      "label": "Will this panel include a PLC or controller inside?",
      "help": "Adds reserved space and terminals for PLC I/O.",
      "type": "boolean",
      "required": true,
      "default": false
    },
    {
      "id": "control_voltage",
      "order": 14,
      "label": "What is the control circuit voltage?",
      "help": "Typical options: 230 V AC or 24 V DC.",
      "type": "select",
      "options": [
        {
          "value": "230VAC",
          "label": "230 V AC"
        },
        {
          "value": "24VDC",
          "label": "24 V DC"
        }
      ],
      "required": true,
      "default": "24VDC"
    },
    {
      "id": "notes",
      "order": 15,
      "label": "Any special notes or constraints?",
      "help": "Free text. Example: Pump 1 is VFD, Feeder F3 needs RCD.",
      "type": "text",
      "multiline": true,
      "required": false
    }
  ]
}