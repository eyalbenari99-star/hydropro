{
  "discipline": "plumbing",
  "version": 1,
  "questions": [
    {
      "id": "system_type",
      "order": 1,
      "label": "What type of hydraulic system do you need?",
      "help": "This controls the layout template and default components.",
      "type": "select",
      "options": [
        {
          "value": "irrigation",
          "label": "Irrigation (field zones / drippers / sprinklers)"
        },
        {
          "value": "fertigation",
          "label": "Fertigation (injection + irrigation)"
        },
        {
          "value": "water_supply",
          "label": "Water supply / booster set"
        },
        {
          "value": "filtration",
          "label": "Filtration skid only"
        }
      ],
      "required": true
    },
    {
      "id": "water_source",
      "order": 2,
      "label": "What is the water source?",
      "help": "Select the primary source feeding the system.",
      "type": "select",
      "options": [
        {
          "value": "well",
          "label": "Well / borehole"
        },
        {
          "value": "reservoir",
          "label": "Reservoir / open tank"
        },
        {
          "value": "municipal",
          "label": "Municipal network"
        },
        {
          "value": "recycled",
          "label": "Recycled / treated water"
        }
      ],
      "required": true
    },
    {
      "id": "zones_count",
      "order": 3,
      "label": "How many irrigation zones / lines?",
      "help": "Number of separately controlled field blocks or manifolds.",
      "type": "number",
      "min": 1,
      "max": 64,
      "step": 1,
      "required": true,
      "default": 4
    },
    {
      "id": "flow_per_zone_m3h",
      "order": 4,
      "label": "Design flow per zone (m3/h)?",
      "help": "Average design flow per irrigation zone.",
      "type": "number",
      "min": 0.5,
      "max": 200,
      "step": 0.1,
      "required": true,
      "default": 10
    },
    {
      "id": "pressure_at_field_bar",
      "order": 5,
      "label": "Required pressure at field manifolds (bar)?",
      "help": "Pressure at the downstream manifolds or valves.",
      "type": "number",
      "min": 1,
      "max": 10,
      "step": 0.1,
      "required": true,
      "default": 3
    },
    {
      "id": "elevation_difference_m",
      "order": 6,
      "label": "Elevation difference from plant to field (m)?",
      "help": "Positive if fields are above the plant, negative if below.",
      "type": "number",
      "min": -50,
      "max": 100,
      "step": 1,
      "required": true,
      "default": 0
    },
    {
      "id": "filtration_grade",
      "order": 7,
      "label": "What filtration grade do you need?",
      "help": "Finer filtration for drippers; coarser for sprinklers or general use.",
      "type": "select",
      "options": [
        {
          "value": 130,
          "label": "130 micron (standard for drippers)"
        },
        {
          "value": 100,
          "label": "100 micron (fine)"
        },
        {
          "value": 80,
          "label": "80 micron (sprinklers / general)"
        },
        {
          "value": 50,
          "label": "50 micron (very fine)"
        }
      ],
      "required": true,
      "default": 130
    },
    {
      "id": "filtration_type",
      "order": 8,
      "label": "Preferred filter type?",
      "help": "Sand filters handle dirt load; disc filters protect drippers.",
      "type": "select",
      "options": [
        {
          "value": "sand",
          "label": "Sand filter battery"
        },
        {
          "value": "disc",
          "label": "Disc filter"
        },
        {
          "value": "both",
          "label": "Sand + disc in series"
        },
        {
          "value": "auto",
          "label": "Let the system choose"
        }
      ],
      "required": true,
      "default": "auto"
    },
    {
      "id": "has_fertigation",
      "order": 9,
      "label": "Do you require fertigation (chemical injection)?",
      "help": "If yes, the system adds fertilizer tanks and dosing units.",
      "type": "boolean",
      "required": true,
      "default": false
    },
    {
      "id": "fertilizer_tanks_count",
      "order": 10,
      "label": "How many fertilizer tanks (drums)?",
      "help": "Used for A/B/C fertilizer solutions; ignored if fertigation is disabled.",
      "type": "number",
      "min": 0,
      "max": 6,
      "step": 1,
      "required": false,
      "default": 0
    },
    {
      "id": "dosing_unit_type",
      "order": 11,
      "label": "Preferred dosing technology?",
      "help": "Venturi injectors are simple; dosing pumps and venturi blocks allow advanced fertigation.",
      "type": "select",
      "options": [
        {
          "value": "venturi",
          "label": "Venturi injectors"
        },
        {
          "value": "dosing_pumps",
          "label": "Dosing pumps"
        },
        {
          "value": "auto_block",
          "label": "Automatic fertigation block"
        },
        {
          "value": "auto",
          "label": "Let the system choose"
        }
      ],
      "required": true,
      "default": "auto"
    },
    {
      "id": "main_pipe_material",
      "order": 12,
      "label": "Main line pipe material?",
      "help": "Choice affects pressure rating and DN recommendations.",
      "type": "select",
      "options": [
        {
          "value": "PVC",
          "label": "PVC (rigid)"
        },
        {
          "value": "PE",
          "label": "PE (flexible)"
        },
        {
          "value": "Steel",
          "label": "Steel"
        }
      ],
      "required": true,
      "default": "PVC"
    }
  ]
}